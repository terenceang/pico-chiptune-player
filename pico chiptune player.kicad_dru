# JLCPCB Design Rules for KiCad
# Specifications: JLCPCB Standard Process (2-Layer / 4-Layer)

(version 1)

(rule "JLCPCB Minimum Clearance"
	(description "JLCPCB minimum 5mil (0.127mm) copper clearance")
	(constraint clearance (min 0.127mm)))

(rule "JLCPCB Minimum Track Width"
	(description "JLCPCB minimum 5mil (0.127mm) trace width")
	(constraint track_width (min 0.127mm)))

(rule "JLCPCB Minimum Via Hole"
	(description "JLCPCB minimum 0.3mm via drill size")
	(constraint hole (min 0.3mm))
	(condition "A.type == 'via'"))

(rule "JLCPCB Minimum Via Diameter"
	(description "JLCPCB minimum 0.5mm via pad diameter")
	(constraint via_diameter (min 0.5mm))
	(condition "A.type == 'via'"))

(rule "JLCPCB Hole to Hole Clearance"
	(description "JLCPCB minimum 0.254mm (10mil) hole-to-hole clearance")
	(constraint hole_to_hole (min 0.254mm)))

(rule "JLCPCB Board Edge Clearance"
	(description "JLCPCB minimum 0.3mm copper-to-board-edge clearance")
	(constraint edge_clearance (min 0.3mm)))

(rule "JLCPCB Silkscreen Text Height"
	(description "JLCPCB minimum 0.8mm silk text height for legibility")
	(constraint text_height (min 0.8mm)))

(rule "JLCPCB Silkscreen Text Line Width"
	(description "JLCPCB minimum 0.15mm silk stroke width")
	(constraint text_thickness (min 0.15mm)))

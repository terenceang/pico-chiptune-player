# JLCPCB Design Rules for KiCad

(version 1)

(rule "JLCPCB Trace Clearance"
	(constraint clearance (min 0.127mm))
	(condition "A.type == 'track'"))

(rule "JLCPCB Track Width"
	(constraint track_width (min 0.127mm))
	(condition "A.type == 'track'"))

(rule "JLCPCB Via Hole Size"
	(constraint hole_size (min 0.3mm))
	(condition "A.type == 'via'"))

(rule "JLCPCB Via Diameter"
	(constraint via_diameter (min 0.5mm))
	(condition "A.type == 'via'"))

(rule "JLCPCB Hole to Hole Clearance"
	(constraint hole_to_hole (min 0.254mm))
	(condition "A.type == 'pad' || A.type == 'via'"))

(rule "JLCPCB Board Edge Clearance"
	(constraint edge_clearance (min 0.3mm))
	(condition "A.type == 'track' || A.type == 'via' || A.type == 'pad'"))

(rule "JLCPCB Silkscreen Text Height"
	(constraint text_height (min 0.8mm))
	(condition "A.type == 'text' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS')"))

(rule "JLCPCB Silkscreen Text Line Width"
	(constraint text_thickness (min 0.15mm))
	(condition "A.type == 'text' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS')"))
